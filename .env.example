# Backend
SNU_API_HOST=127.0.0.1
SNU_API_PORT=8000
SNU_DB=./snu.db                  # SQLite path for local mode
SNU_MAX_CONCURRENT_JOBS=2
SNU_JOB_TTL_SECONDS=3600
SNU_LOG_LEVEL=info

# Frontend
SNU_WEB_PORT=5173
SNU_API_BASE=http://127.0.0.1:8000   # blank = same origin (reverse proxy)

# Production only (not used in local SQLite mode)
# DATABASE_URL=postgresql://snu:snu@db:5432/snu
