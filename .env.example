# Backend
SNU_API_HOST=127.0.0.1
SNU_API_PORT=8000
SNU_DB=./snu.db                  # SQLite path for local mode
SNU_MAX_CONCURRENT_JOBS=2
SNU_JOB_TTL_SECONDS=3600
SNU_LOG_LEVEL=info

# Frontend
SNU_WEB_PORT=5173
SNU_API_BASE=http://127.0.0.1:8000   # blank = same origin (reverse proxy)

# Production only (not used in local SQLite mode)
# DATABASE_URL=postgresql://snu:snu@db:5432/snu

# Timetable-update poller (backend/app/timetable_updates/poller.py). Checks
# the live source periodically; a clean (zero-error) candidate applies
# itself automatically, an invalid one always waits for manual review via
# GET/POST /api/v1/timetable-updates/* regardless of this setting - see
# CLAUDE.md, session 2026-08-09/10, for why this was turned on: the poller
# had been correctly detecting real site changes for days (2026-08-04
# through 08-09) but nobody was reviewing the staged candidates, so the
# active dataset silently drifted 5+ days behind the live timetable.
SNU_TIMETABLE_UPDATE_ENABLED=true
SNU_TIMETABLE_UPDATE_INTERVAL_MINUTES=15
SNU_TIMETABLE_UPDATE_URL=https://snioe-monsoon2026-tt.netlify.app/
SNU_TIMETABLE_AUTO_APPLY=true
